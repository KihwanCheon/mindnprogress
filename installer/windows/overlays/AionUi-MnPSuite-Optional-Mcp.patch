+describe('buildMnPSuiteOptionalMcpBootstrap', () => {
+  it('builds only allowlisted package-managed stdio servers', () => {
+    const directory = mkdtempSync(path.join(tmpdir(), 'aionui-mnp-suite-mcp-'));
+    temporaryDirectories.push(directory);
+    const configPath = path.join(directory, 'mcp-bootstrap.json');
+    writeFileSync(
+      configPath,
+      JSON.stringify({
+        schemaVersion: 1,
+        servers: [
+          {
+            name: 'pptx-mcp',
+            description: 'PowerPoint MCP installed by MnP Suite',
+            command: process.execPath,
+            args: ['server.js'],
+          },
+        ],
+      })
+    );
+
+    const bootstrap = buildMnPSuiteOptionalMcpBootstrap(configPath);
+
+    expect(bootstrap?.managedNames).toEqual(['dooray-mcp', 'pptx-mcp']);
+    expect(bootstrap?.servers).toHaveLength(1);
+    expect(bootstrap?.servers[0]).toMatchObject({
+      name: 'pptx-mcp',
+      enabled: true,
+      builtin: false,
+      transport: { type: 'stdio', command: process.execPath, args: ['server.js'] },
+    });
+    expect(isMnPSuiteManagedMcpServer(bootstrap!.servers[0] as never)).toBe(true);
+  });
+
+  it('rejects invalid, duplicate, and non-allowlisted descriptors', () => {
+    const directory = mkdtempSync(path.join(tmpdir(), 'aionui-mnp-suite-invalid-'));
+    temporaryDirectories.push(directory);
+    const configPath = path.join(directory, 'mcp-bootstrap.json');
+    writeFileSync(configPath, JSON.stringify({ schemaVersion: 1, servers: [{ name: 'other', command: process.execPath }] }));
+    expect(buildMnPSuiteOptionalMcpBootstrap(configPath)).toBeNull();
+
+    writeFileSync(
+      configPath,
+      JSON.stringify({
+        schemaVersion: 1,
+        servers: [
+          { name: 'pptx-mcp', command: process.execPath },
+          { name: 'pptx-mcp', command: process.execPath },
+        ],
+      })
+    );
+    expect(buildMnPSuiteOptionalMcpBootstrap(configPath)).toBeNull();
+  });
+
+  it('does not classify user-owned original JSON as package-managed', () => {
+    expect(isMnPSuiteManagedMcpServer({ original_json: '{"mcpServers":{}}' })).toBe(false);
+    expect(isMnPSuiteManagedMcpServer({ original_json: 'invalid' })).toBe(false);
