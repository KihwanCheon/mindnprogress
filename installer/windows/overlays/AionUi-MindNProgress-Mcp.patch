+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { statSync } from 'node:fs';
+import path from 'node:path';
+import type { IMcpServer } from '@/common/config/storage';
+
+export const MINDNPROGRESS_MCP_NAME = 'MindNProgress';
+export const MINDNPROGRESS_MCP_ENTRY_ENV = 'MINDNPROGRESS_MCP_ENTRY';
+
+type MindNProgressMcpServer = Partial<IMcpServer> & Pick<IMcpServer, 'name' | 'transport'>;
+
+function isExistingFile(filePath: string): boolean {
+  try {
+    return statSync(filePath).isFile();
+  } catch {
+    return false;
+  }
+}
+
+export function buildMindNProgressMcpServer(
+  entryPath = process.env[MINDNPROGRESS_MCP_ENTRY_ENV]
+): MindNProgressMcpServer | null {
+  const normalizedEntryPath = entryPath?.trim();
+  if (!normalizedEntryPath || !path.isAbsolute(normalizedEntryPath) || !isExistingFile(normalizedEntryPath)) {
+    return null;
+  }
+
+  const serverConfig = {
+    command: 'node',
+    args: [normalizedEntryPath],
+  };
+
+  return {
+    name: MINDNPROGRESS_MCP_NAME,
+    description: 'Required local MCP server for MindNProgress conversations',
+    enabled: true,
+    builtin: false,
+    transport: {
+      type: 'stdio',
+      command: serverConfig.command,
+      args: serverConfig.args,
+    },
+    original_json: JSON.stringify({ mcpServers: { [MINDNPROGRESS_MCP_NAME]: serverConfig } }, null, 2),
+  };
+}
