+/**
+ * @license
+ * Copyright 2025 AionUi (aionui.com)
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { buildMindNProgressMcpServer } from '@/process/utils/mindNProgressMcpBootstrap';
+import { afterEach, describe, expect, it } from 'vitest';
+
+const temporaryDirectories: string[] = [];
+
+afterEach(() => {
+  for (const directory of temporaryDirectories.splice(0)) {
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
+
+describe('buildMindNProgressMcpServer', () => {
+  it('ignores missing, relative, and nonexistent entry paths', () => {
+    expect(buildMindNProgressMcpServer('')).toBeNull();
+    expect(buildMindNProgressMcpServer('MindNProgress/mcp/server.mjs')).toBeNull();
+    expect(buildMindNProgressMcpServer(path.join(tmpdir(), 'missing-mindnprogress-mcp.mjs'))).toBeNull();
+  });
+
+  it('builds an enabled stdio server for an existing absolute entry path', () => {
+    const directory = mkdtempSync(path.join(tmpdir(), 'aionui-mnp-mcp-'));
+    temporaryDirectories.push(directory);
+    expect(buildMindNProgressMcpServer(directory)).toBeNull();
+    const entryPath = path.join(directory, 'server.mjs');
+    writeFileSync(entryPath, '');
+
+    const server = buildMindNProgressMcpServer(entryPath);
+
+    expect(server).toMatchObject({
+      name: 'MindNProgress',
+      enabled: true,
+      builtin: false,
+      transport: {
+        type: 'stdio',
+        command: 'node',
+        args: [entryPath],
+      },
+    });
+    expect(server?.original_json).toContain(entryPath.replaceAll('\\', '\\\\'));
+  });
+});
