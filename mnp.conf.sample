# MindNProgress 샘플 설정
#
# 사용법
#   mkdir -p ~/.mnp
#   cp mnp.conf.sample ~/.mnp/mnp.conf
#   복사한 ~/.mnp/mnp.conf를 이 PC에 맞게 고친다. 저장소 밖에 있으므로 Git에 올라가지 않는다.
#
# ~/.mnp/mnp.conf가 없으면 이 샘플을 대신 읽는다. 그래서 이 파일에서는 서버 기본값과 같은
# 안전한 값만 켜 두고, 공개 주소처럼 PC마다 다른 값은 주석으로만 남긴다.
# 실제 도메인은 이 파일이 아니라 ~/.mnp/mnp.conf에 쓴다.
#
# 형식      KEY=VALUE를 한 줄에 하나씩 쓴다. #으로 시작하는 줄은 주석이다.
# 우선순위  OS·실행 배치 환경변수 > 저장소 .env.local > ~/.mnp/mnp.conf (없으면 이 파일)
# 반영      값을 바꾸면 npm run dev 또는 npm start를 다시 시작해야 한다.
# 폴더 위치 MNP_CONFIG_DIR 환경변수로 ~/.mnp 대신 다른 폴더를 쓸 수 있다.

# ---------------------------------------------------------------------------
# 서버 바인딩
# ---------------------------------------------------------------------------

# API 서버가 바인딩할 주소.
# 리버스 프록시를 쓰면 127.0.0.1로 두고 외부 노출은 프록시에 맡긴다.
MNP_API_HOST=127.0.0.1

# API 서버 포트. npm start에서는 빌드된 화면도 이 포트로 제공한다.
# Vite 개발 서버(npm run dev)의 /api 프록시도 이 값을 따른다.
MNP_API_PORT=4176

# 공유 URL을 자동으로 만들 때 쓰는 웹 포트. MNP_PUBLIC_URL을 지정하면 쓰이지 않는다.
MNP_WEB_PORT=4175

# ---------------------------------------------------------------------------
# 공개 주소 (리버스 프록시 뒤에서 도메인으로 접속할 때)
# ---------------------------------------------------------------------------

# 공유 링크와 AI가 기록하는 접근 URL의 기준 주소.
# 비워 두면 이 PC의 LAN IPv4와 MNP_WEB_PORT로 자동 생성한다.
# 이 호스트는 Vite 개발 서버의 허용 호스트에도 자동으로 추가된다.
# MNP_PUBLIC_URL=https://mnp.example.com

# MNP_PUBLIC_URL을 비워 둔 경우 자동 감지에 우선 사용할 네트워크 인터페이스 이름.
# 정확한 이름을 먼저 찾고 없으면 일부 일치로 찾으며, 찾지 못하면 기존 자동 감지로 돌아간다.
# MNP_PUBLIC_INTERFACE=Ethernet

# 원격 브라우저에서 'AI 대화 열기'가 여는 AionUi WebUI 주소.
# 호스트 루트여야 한다. 서브패스(예: /aionui/)로는 대화 링크가 동작하지 않는다.
# 비워 두면 MNP_PUBLIC_URL과 같은 호스트의 7777 포트를 쓴다.
# MNP_AIONUI_WEB_URL=https://aion.example.com

# MNP_PUBLIC_URL 외에 Vite 개발 서버가 추가로 허용할 호스트. 쉼표로 구분한다.
# MNP_DEV_ALLOWED_HOSTS=dev.example.com,other.example.com

# ---------------------------------------------------------------------------
# 접근 제어
# ---------------------------------------------------------------------------

# 로그인 없이 읽기 전용으로 보는 공개 뷰어.
# true로 켜면 주소를 아는 누구나 모든 문서를 읽을 수 있으므로 인터넷에 노출된 인스턴스에서는 켜지 않는다.
# MNP_PUBLIC_VIEWER_ENABLED=false
